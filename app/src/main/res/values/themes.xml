<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal platform theme. All real styling happens in Compose (see LocalAiTheme).
  This exists so the launch window matches the app background instead of flashing white.
-->
<resources>
    <style name="Theme.LocalAI" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
