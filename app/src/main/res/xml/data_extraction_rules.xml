<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml. Same reasoning. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="local_ai.db" />
        <exclude domain="database" path="local_ai.db-shm" />
        <exclude domain="database" path="local_ai.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="local_ai.db" />
        <exclude domain="database" path="local_ai.db-shm" />
        <exclude domain="database" path="local_ai.db-wal" />
    </device-transfer>
</data-extraction-rules>
